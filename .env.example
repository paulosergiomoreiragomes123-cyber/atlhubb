# Supabase Postgres — pegue em Project Settings > Database > Connection string.
# LOCAL/dev: use a conexão DIRETA (porta 5432, db.xxx.supabase.co) — mais simples,
# funciona bem numa máquina com IPv6/rota direta.
# VERCEL (produção/preview): a conexão direta EXIGE IPv6 no Supabase (sem o
# add-on pago de IPv4), e as funções serverless da Vercel só têm saída IPv4 —
# confirmado ao vivo (2026-07-15): "Can't reach database server" em todo
# request na Vercel, funcionando perfeitamente local. Use a conexão com
# CONNECTION POOLING (Supavisor, porta 6543, modo Transaction) como
# DATABASE_URL na Vercel: Project Settings > Database > Connection pooling.
# Formato: postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-<região>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Gere com `npx auth secret` ou `openssl rand -base64 32`.
AUTH_SECRET=""

# Usados apenas pelo script de seed (prisma/seed.ts) para criar o primeiro administrador.
ADMIN_NAME="Administrador AtlHub"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Assistente de IA (Fase 4) — gere em https://vercel.com/{team}/{project}/settings (AI Gateway).
# Sem isso, o chat em /consultor/assistente-ia não consegue chamar nenhum modelo.
AI_GATEWAY_API_KEY=""

# Revista digital (Fase 5) — crie um Blob Store em Storage > Blob no dashboard
# da Vercel; a variável é provisionada automaticamente ao linkar o projeto,
# ou copie manualmente. Sem isso, o upload de PDF/capa falha (mas ainda dá pra
# usar o campo de URL manual como alternativa).
BLOB_READ_WRITE_TOKEN=""

# Domínio público do deploy — usado pra montar a URL que o QR Code aponta
# (/c/[slug]). Sem isso, cai em http://localhost:3000 (só funciona em dev).
NEXT_PUBLIC_APP_URL=""

# Fase 6A — login de consultor na loja pública (loja.atlanticanatural.com.br),
# usado pelo crawler de sincronização (src/modules/store-sync). Sem isso,
# `npm run store:sync` e o cron falham ao autenticar.
LOJA_ATLANTICA_USERNAME=""
LOJA_ATLANTICA_PASSWORD=""

# Protege app/api/cron/sync-loja de disparo externo — gere um valor aleatório
# (ex.: `openssl rand -base64 32`) e configure o mesmo valor nas envs da Vercel.
CRON_SECRET=""
